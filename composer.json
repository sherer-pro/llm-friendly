{
	"name": "sherer-pro/llm-friendly",
	"description": "Publishes llms.txt, structured catalogs and Markdown for public WordPress content, with optional unavailable-URL integrations.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"scripts": {
		"lint": [
			"@php -l llm-friendly.php",
			"@php -l inc/Admin.php",
			"@php -l inc/Catalog.php",
			"@php -l inc/Content.php",
			"@php -l inc/Diagnostics.php",
			"@php -l inc/Exporter.php",
			"@php -l inc/Llms.php",
			"@php -l inc/Markdown.php",
			"@php -l inc/Options.php",
			"@php -l inc/Plugin.php",
			"@php -l inc/UnavailableMarkdown.php",
			"@php -l inc/Response.php",
			"@php -l inc/Rewrites.php",
			"@php -l tests/run.php",
			"@php -l tests/unavailable-markdown.php",
			"@php -l tests/mechanics.php",
			"@php -l tests/mechanics-stubs.php",
			"@php -l tests/wordpress-mechanics.php",
			"@php -l tests/wordpress-unavailable-markdown.php",
			"@php -l tests/wordpress-scale.php"
		],
		"test": [
			"@php tests/run.php"
		]
	}
}
